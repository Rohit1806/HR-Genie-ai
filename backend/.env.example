# ─── APPLICATION ──────────────────────────────────────
APP_ENV=development
APP_NAME=HRGenie AI
APP_VERSION=1.0.0
DEBUG=true

# ─── DATABASE ─────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://hrgenie:hrgenie123@localhost:5432/hrgenie_db

# ─── REDIS ────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ─── JWT ──────────────────────────────────────────────
JWT_SECRET_KEY=your-super-secret-key-change-this-in-production-minimum-64-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── AI SERVICES ──────────────────────────────────────
GEMINI_API_KEY=your_google_ai_studio_key_here
GEMINI_MODEL=gemini-1.5-flash

# ─── FILE STORAGE ─────────────────────────────────────
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./uploads
SIGNED_URL_EXPIRE_SECONDS=3600

# ─── EMAIL ────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM=noreply@hrgenie.ai
EMAIL_FROM_NAME=HRGenie AI

# ─── CORS ─────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── RATE LIMITING ────────────────────────────────────
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_AI=30/minute

# ─── FEATURE FLAGS ────────────────────────────────────
ENABLE_VOICE_SCREENING=true
ENABLE_AI_COPILOT=true
ENABLE_ATTRITION_PREDICTION=true
AI_CONFIDENCE_THRESHOLD=0.70
